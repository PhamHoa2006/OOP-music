<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" spacing="20.0" style="-fx-background-color: #282828; -fx-padding: 30;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicPlayer.CreatePlaylistController">

   <Label text="Danh sách phát mới" textFill="WHITE">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
      <VBox.margin>
         <Insets bottom="10.0" />
      </VBox.margin>
   </Label>

   <VBox spacing="5.0">
      <TextField fx:id="nameField" promptText="Tiêu đề" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #b3b3b3; -fx-border-color: transparent transparent #3E90F6 transparent; -fx-border-width: 2px; -fx-padding: 5 0 5 0;">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
   </VBox>

   <VBox spacing="5.0">
      <TextField fx:id="descField" promptText="Thông tin mô tả" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #b3b3b3; -fx-border-color: transparent transparent #555555 transparent; -fx-border-width: 1px; -fx-padding: 5 0 5 0;">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
   </VBox>

   <VBox spacing="5.0">
      <Label text="Quyền riêng tư" textFill="#b3b3b3">
         <font>
            <Font size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="privacyCombo" prefWidth="150.0" promptText="Công khai" style="-fx-background-color: #3E3E3E; -fx-text-fill: white; -fx-mark-color: white;" />
   </VBox>

   <Region VBox.vgrow="ALWAYS" />

   <HBox alignment="CENTER_RIGHT" spacing="15.0">
      <Button fx:id="cancelBtn" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Hủy" />
      
      <Button fx:id="createBtn" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 25; -fx-cursor: hand;" text="Tạo" />
   </HBox>

</VBox>
