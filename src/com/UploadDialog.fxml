<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: #282828; -fx-border-color: #404040; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicPlayer.UploadDialogController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label text="Thông tin bài hát" textFill="WHITE">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <VBox spacing="5.0">
         <Label text="Tên bài hát" textFill="#b3b3b3" />
         <TextField fx:id="titleField" promptText="Ví dụ: Chúng Ta Của Hiện Tại" style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #808080;" />
      </VBox>

      <VBox spacing="5.0">
         <Label text="Nghệ sĩ" textFill="#b3b3b3" />
         <TextField fx:id="artistField" promptText="Ví dụ: Sơn Tùng M-TP" style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #808080;" />
      </VBox>

      <Region VBox.vgrow="ALWAYS" />

      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Hủy" />
         <Button onAction="#handleSave" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="Lưu &amp; Thêm" />
      </HBox>
   </children>
</VBox>