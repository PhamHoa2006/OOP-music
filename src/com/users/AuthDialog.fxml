<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootBox" alignment="CENTER" prefWidth="350.0" spacing="20.0" style="-fx-background-color: #282828; -fx-border-color: #404040; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.users.AuthDialogController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="titleLabel" text="Đăng Nhập" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleClose" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-font-size: 14px; -fx-cursor: hand;" text="✕" />
         </children>
      </HBox>

      <VBox spacing="15.0">
         <VBox spacing="5.0">
            <Label text="Tên đăng nhập" textFill="#b3b3b3" />
            <TextField fx:id="usernameField" promptText="Nhập username..." style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #808080;" />
         </VBox>

         <VBox spacing="5.0">
            <Label text="Mật khẩu" textFill="#b3b3b3" />
            <PasswordField fx:id="passwordField" promptText="******" style="-fx-background-color: #404040; -fx-text-fill: white; -fx-prompt-text-fill: #808080;" />
         </VBox>
         
         <Label fx:id="messageLabel" textFill="#ff5555" wrapText="true" />
      </VBox>

      <Button fx:id="actionBtn" maxWidth="1.7976931348623157E308" onAction="#handleAction" style="-fx-background-color: #1DB954; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 10;" text="ĐĂNG NHẬP" />

      <HBox alignment="CENTER" spacing="5.0">
         <children>
            <Label fx:id="switchLabel" text="Chưa có tài khoản?" textFill="#b3b3b3" />
            <Button fx:id="switchModeBtn" onAction="#toggleMode" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" text="Đăng ký ngay" underline="true" />
         </children>
      </HBox>
   </children>
</VBox>