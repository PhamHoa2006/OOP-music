<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.users.UserProfileController">
   <children>
      <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@icons/logo.png" />
         </image>
      </ImageView>
      
      <Label fx:id="welcomeLabel" text="Xin chào, User!" textFill="WHITE">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      
      <Label text="Gói dịch vụ: Premium (Vĩnh viễn)" textFill="#1db954">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Button style="-fx-background-color: #333; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 20;" text="Chỉnh sửa hồ sơ" />
      <Button style="-fx-background-color: #333; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 20;" text="Cài đặt ứng dụng" />
      
      <Button onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #ff5555; -fx-border-color: #ff5555; -fx-border-radius: 20; -fx-padding: 8 30; -fx-cursor: hand;" text="Đăng xuất">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>