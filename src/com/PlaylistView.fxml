<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="playlistViewRoot" prefHeight="600.0" prefWidth="900.0" spacing="30.0" style="-fx-background-color: #030303;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <VBox alignment="TOP_CENTER" maxWidth="300.0" minWidth="250.0" spacing="15.0">
         <children>
            <ImageView fx:id="detailPlaylistImg" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);">
               <image>
                  <Image url="@icons/logo.png" />
               </image>
            </ImageView>
            
            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label fx:id="detailPlaylistTitle" text="Tên Playlist" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label fx:id="detailPlaylistCreator" text="Người tạo • 2025" textFill="#aaaaaa">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="detailPlaylistDesc" text="Mô tả danh sách phát..." textFill="#808080" wrapText="true" />
               </children>
            </VBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="detailPlayAllBtn" mnemonicParsing="false" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;" text="Phát tất cả" />
                  <Button fx:id="detailShuffleBtn" mnemonicParsing="false" style="-fx-background-color: #262626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 25; -fx-cursor: hand;" text="Trộn bài" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="10.0" HBox.hgrow="ALWAYS">
         <children>
            
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Button fx:id="sortBtn" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #b3b3b3; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" text="Sắp xếp ▾" />
               </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
            </HBox>

            <HBox style="-fx-border-color: transparent transparent #2a2a2a transparent; -fx-padding: 0 0 10 0;">
                <Label prefWidth="40" text="#" textFill="#aaaaaa" />
                <Label prefWidth="250" text="Tiêu đề" textFill="#aaaaaa" />
                <Region HBox.hgrow="ALWAYS" />
                <Label prefWidth="60" text="Thời lượng" textFill="#aaaaaa" />
            </HBox>
            
            <ScrollPane fx:id="playlistScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" styleClass="playlist-scroll" vbarPolicy="AS_NEEDED">
               <content>
                  <VBox fx:id="detailSongContainer" spacing="0.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</HBox>
